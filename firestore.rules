rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Primitives
    function isSignedIn() { return request.auth != null; }
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isValidId(id) { 
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    // Validation for UserAccount
    function isValidUserAccount(data, uid) {
       return data.userId == uid
       && data.userId is string;
    }
    
    // Validation for UserSubscription
    function isValidSubscription(data, uid) {
       return data.userId == uid
       && data.userId is string
       && data.status is string
       && (data.status == 'trial' || data.status == 'active' || data.status == 'expired' || data.status == 'none');
    }
    
    // Match userAccounts/{userId}
    match /userAccounts/{userId} {
       allow get: if isSignedIn() && request.auth.uid == userId;
       // Prevent list access even for own, not needed.
       allow list: if false; 
       
       allow create: if isSignedIn() 
                     && request.auth.uid == userId
                     && isValidUserAccount(incoming(), request.auth.uid);
                     
       allow update: if isSignedIn()
                     && request.auth.uid == userId
                     && (!('userId' in incoming()) || incoming().userId == request.auth.uid)
                     && (!('userId' in existing()) || !('userId' in incoming()) || incoming().userId == existing().userId);
                     
       allow delete: if isSignedIn() 
                     && request.auth.uid == userId;
    }
    
    // Match userSubscriptions/{userId}
    match /userSubscriptions/{userId} {
       allow get: if isSignedIn() && request.auth.uid == userId;
       allow list: if false;
       
       allow create: if isSignedIn()
                     && request.auth.uid == userId
                     && isValidSubscription(incoming(), request.auth.uid);
                     
       allow update: if isSignedIn()
                     && request.auth.uid == userId
                     && (!('userId' in incoming()) || incoming().userId == request.auth.uid)
                     && (!('userId' in existing()) || !('userId' in incoming()) || incoming().userId == existing().userId)
                     && (!('status' in incoming()) || incoming().status in ['trial', 'active', 'expired', 'none']);
                     
       allow delete: if isSignedIn()
                     && request.auth.uid == userId;
    }
  }
}
